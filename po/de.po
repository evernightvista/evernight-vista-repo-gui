#: MainWindow.cpp:307
msgid ""
"Perform system maintenance tasks for DNF/RPM. Each action asks for "
"administrator authentication through polkit."
msgstr "Führt Systemwartungsaufgaben für DNF/RPM durch. Jede Aktion fordert eine Administrator-Authentifizierung über polkit an."

#: MainWindow.cpp:313
msgid "Repair RPM Database"
msgstr "RPM-Datenbank reparieren"

#: MainWindow.cpp:317
msgid "Clean Unused Packages (autoremove)"
msgstr "Nicht verwendete Pakete bereinigen (autoremove)"

#: MainWindow.cpp:321
msgid "Synchronize Distribution (distro-sync)"
msgstr "Distribution synchronisieren (distro-sync)"

#: MainWindow.cpp:374
msgid "This will rebuild the RPM database using 'rpm --rebuilddb'. Continue?"
msgstr "Dies wird die RPM-Datenbank mit 'rpm --rebuilddb' neu aufbauen. Fortfahren?"

#: MainWindow.cpp:380
msgid "Repairing RPM database..."
msgstr "RPM-Datenbank wird repariert..."

#: MainWindow.cpp:385
msgid ""
"This will remove unnecessary packages via 'dnf autoremove -y'. Continue?"
msgstr "Dies wird nicht benötigte Pakete via 'dnf autoremove -y' entfernen. Fortfahren?"

#: MainWindow.cpp:391
msgid "Cleaning unused packages..."
msgstr "Nicht verwendete Pakete werden bereinigt..."

#: MainWindow.cpp:396
msgid ""
"This will synchronize your system with the repository via 'dnf distro-sync "
